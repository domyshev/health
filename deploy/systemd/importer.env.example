# Copy this file to /etc/health-hub/importer.env with mode 0600.
# Replace every placeholder before enabling the timer.
HEALTH_HUB_DATABASE_URL=postgresql://health_hub:replace-me@127.0.0.1:5432/health_hub
HEALTH_HUB_GARMIN_CONNECTION_ID=00000000-0000-0000-0000-000000000000
HEALTH_HUB_USER_ID=00000000-0000-0000-0000-000000000000
